{
  "name": "hvy",
  "displayName": "HVY Editor",
  "description": "VS Code custom editor for .hvy, .thvy, and .phvy files.",
  "version": "0.1.1",
  "publisher": "HeavyResume",
  "license": "MIT",
  "icon": "media/icon.png",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "build:vendor": "node scripts/build-local-vendor.cjs",
    "use:hvy-local": "node scripts/set-hvy-dependency.cjs local",
    "use:hvy-git": "node scripts/set-hvy-dependency.cjs git",
    "package:local": "npm run use:hvy-local && npm install && npm run build:vendor && npm run compile && vsce package --no-dependencies --allow-missing-repository --out hvy.vsix",
    "install:local": "npm run package:local && code --install-extension hvy.vsix --force",
    "package:release": "npm run use:hvy-git && npm install && npm run compile"
  },
  "dependencies": {
    "heavy-file-format-ref-impl": "file:../heavy-file-format"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.8.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "hvy.showOutput",
        "title": "HVY: Show Debug Output"
      },
      {
        "command": "hvy.openPreview",
        "title": "HVY: Open Preview",
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hvy.openPreview",
          "when": "resourceExtname == .hvy || resourceExtname == .thvy || resourceExtname == .phvy",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "hvy",
        "aliases": [
          "HVY"
        ],
        "extensions": [
          ".hvy"
        ],
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      },
      {
        "id": "thvy",
        "aliases": [
          "THVY"
        ],
        "extensions": [
          ".thvy"
        ],
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      },
      {
        "id": "phvy",
        "aliases": [
          "PHVY"
        ],
        "extensions": [
          ".phvy"
        ],
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "hvy.editor",
        "displayName": "HVY Editor",
        "selector": [
          {
            "filenamePattern": "*.hvy"
          },
          {
            "filenamePattern": "*.thvy"
          },
          {
            "filenamePattern": "*.phvy"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "HVY",
      "properties": {
        "hvy.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "qwen"
          ],
          "default": "openai",
          "description": "AI provider used by HVY editor chat and edit features."
        },
        "hvy.ai.model": {
          "type": "string",
          "default": "gpt-5.4-mini",
          "description": "AI model used by HVY editor chat and edit features."
        },
        "hvy.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "Provider API key. Prefer setting this as a user setting; it is only read by the extension host."
        },
        "hvy.ai.compactionModel": {
          "type": "string",
          "default": "gpt-5.4-nano",
          "description": "OpenAI model used for HVY chat compaction when the reference implementation requests compaction."
        },
        "hvy.ai.openAiReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "default": "low",
          "description": "Reasoning effort to send with OpenAI Responses API requests."
        },
        "hvy.editor.defaultMode": {
          "type": "string",
          "enum": [
            "viewer",
            "ai",
            "editor",
            "advanced"
          ],
          "default": "viewer",
          "description": "Default mode used when opening .hvy, .thvy, and .phvy files."
        },
        "hvy.editor.showModeControls": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Viewer, AI, Editor, and Advanced mode controls in the HVY webview."
        }
      }
    }
  }
}
